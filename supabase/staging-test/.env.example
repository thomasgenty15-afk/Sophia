# Sophia staging QA environment.
# Copy to `supabase/staging-test/.env` and fill the values locally.
# Do not commit real keys.

SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# Optional, only if a staging QA runner needs to call protected internal functions.
INTERNAL_FUNCTION_SECRET=<staging-internal-function-secret>

# Optional metadata for reports.
SOPHIA_QA_ENV=staging
SOPHIA_QA_REPORT_ROOT=tests/real-personas
