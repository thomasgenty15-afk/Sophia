# Frontend (Vite) environment variables
#
# Usage:
# - Local: copy to `frontend/.env.local` (NOT committed) and fill values.
# - Vercel: set the same variables in Project Settings → Environment Variables.
#
# NOTE: Vite only exposes variables prefixed with `VITE_`.

# --- Local Supabase (CLI) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=__set_from_supabase_status__

# --- Prelaunch lock (optional) ---
# When true, the app routes are restricted to `internal_admins` only and the signup UI is hidden.
# Keep this OFF locally; turn it ON in production if you want "master_admin only".
# VITE_PRELAUNCH_LOCKDOWN=true

# --- Lancement B2C : le monde professionnel est occulté (optionnel) ---
# Quand ce drapeau est vrai :
#  - `/pro`, `/coaches`, `/gyms` et `/communities` ne sont plus routées (404) ;
#  - l'en-tête public perd l'interrupteur des mondes, les trois portes pro et
#    le bouton d'essai coach ; le pied de page perd les mêmes liens ;
#  - `/auth?role=coach` n'ouvre plus l'inscription coach ;
#  - un compte coach ACTIF est refusé à la connexion et déconnecté — sauf s'il
#    est aussi `internal_admins`.
# Rien n'est supprimé : le pro rouvre en remettant ce drapeau à false (et en
# restaurant les quatre entrées de `public/sitemap.xml`).
# VITE_B2C_ONLY=true

# --- Debug (local) ---
# Force the new onboarding-in-chat experience on the web:
# - Redirects `/dashboard` -> `/chat?onboarding=1&scope=web_onboarding`
# - Sends a first message automatically to trigger the onboarding machine
# - Server-side forcing is gated to local Supabase (MEGA_TEST_MODE / kong:8000 / port 54321)
# VITE_FORCE_ONBOARDING_CHAT=1


# --- Production (Supabase Cloud) examples ---
# VITE_SUPABASE_URL=https://ybyqxwnwjvuxckolsddn.supabase.co
# VITE_SUPABASE_ANON_KEY=__your_cloud_anon_key__

# --- Billing / Entitlements (Stripe price ids) ---
# Not secret. Used by the frontend to map subscription.stripe_price_id -> tier (system/alliance/architecte).
# 3 tiers x 2 intervals (monthly/yearly)
VITE_STRIPE_PRICE_ID_SYSTEM_MONTHLY=price_...
VITE_STRIPE_PRICE_ID_SYSTEM_YEARLY=price_...
VITE_STRIPE_PRICE_ID_ALLIANCE_MONTHLY=price_...
VITE_STRIPE_PRICE_ID_ALLIANCE_YEARLY=price_...
VITE_STRIPE_PRICE_ID_ARCHITECTE_MONTHLY=price_...
VITE_STRIPE_PRICE_ID_ARCHITECTE_YEARLY=price_...

