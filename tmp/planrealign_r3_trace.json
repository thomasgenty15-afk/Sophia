      "scope": "web"
    },
    {
      "id": "bebb3627-12ac-4dd0-bb2c-4657a80e49a2",
      "user_id": "c197a42e-7eff-40c8-843a-f1dbcbff7ae9",
      "role": "user",
      "content": "Ok mais je veux pas que ça m’enferme dans tes catégories. Je veux juste comprendre tout ce que je peux raconter pour que l’IA adapte mieux.",
      "agent_used": null,
      "metadata": {
        "request_id": "planrealign-r3-t3",
        "test_persona": true,
        "force_full_ai": true,
        "test_endpoint": "test-send-message"
      },
