    {
      "id": "759c03d0-5721-4d58-b49c-10b7d2a7ac94",
      "user_id": "c197a42e-7eff-40c8-843a-f1dbcbff7ae9",
      "role": "user",
      "content": "Et je vais où exactement pour écrire ça ? Je suis pas sûr de trouver le bon endroit.",
      "agent_used": null,
      "metadata": {
        "request_id": "planrealign-r3-t4",
