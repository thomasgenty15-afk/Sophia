    {
      "id": "d1621b7d-dca4-46de-b699-f0eb05e3423f",
      "user_id": "c197a42e-7eff-40c8-843a-f1dbcbff7ae9",
      "role": "user",
      "content": "Quand tu dis expliquer pourquoi, je dois parler de quoi concrètement ? J’ai peur de mal répondre.",
      "agent_used": null,
      "metadata": {
        "request_id": "planrealign-r3-t2",
        "test_persona": true,
        "force_full_ai": true,
        "test_endpoint": "test-send-message"
