            "runtime_safety_risk_band": "none"
          },
          "created_at": "2026-06-24T13:12:25.256933+00:00"
        },
        {
          "id": "95eee5d2-8847-43ee-8b47-81ec3d47d109",
          "role": "user",
          "content": "Merci, ça me va. On peut clôturer le weekly comme ça, sans changement automatique.",
          "metadata": {
            "request_id": "weekly-qa-20260624-r2-partial_habits_mission_partial-t06",
