    "chat_messages": [
      {
        "role": "user",
        "content": "Tu peux me dire simplement ce qui est vraiment enregistré dans mon espace, sans rien changer ?",
        "scope": "qa-status-recap-2026-06-13-status-recap-real-r6",
        "created_at": "2026-06-12T22:05:20.771652+00:00"
      },
      {
        "role": "assistant",
        "content": "Dans ton espace, je vois un rappel pour relire le dossier budget demain à 09:30 et ton point hebdo récurrent chaque lundi à 08:45. Un ancien rappel de devis est marqué comme annulé. Tes préférences coach sont définies sur un ton chaleureux et direct, avec un focus sur la discipline. Tu n'as pas de cartes ou de sessions actives pour l'instant.",
        "scope": "qa-status-recap-2026-06-13-status-recap-real-r6",
        "created_at": "2026-06-12T22:05:35.594243+00:00"
      },
      {
        "role": "user",
        "content": "Oui, fais-moi le point maintenant, en restant juste factuel.",
